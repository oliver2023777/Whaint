# 营销站公网地址（canonical / OG / sitemap）— 改后需 ./start.sh 重建
PUBLIC_SITE_URL=https://whaint.cn

# 产品站 / 演示站入口
PUBLIC_APP_URL=https://whacore.cn

# 商务联系邮箱
PUBLIC_CONTACT_EMAIL=hello@whalecore.example

# ── 产品进化：构建时从私有仓 Whapub 同步 marketing/changelog ──
SYNC_CHANGELOG=1
WHAPUB_REPO=https://github.com/oliver2023777/Whapub.git
WHAPUB_REF=main
# GitHub → Settings → Developer settings → Personal access tokens
# 权限：至少 Contents: Read（classic 则勾选 repo）
WHAPUB_TOKEN=

TZ=Asia/Shanghai
