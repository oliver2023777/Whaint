---
import HomeHero from '../components/HomeHero.astro';
import CtaLink from '../components/CtaLink.astro';
import DefinitionBlock from '../components/DefinitionBlock.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocale, getMessages, localizePath } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const h = t.home;
---

<BaseLayout title={h.title} description={h.description} path="/">
  <HomeHero />

  <section class="section section-split" aria-labelledby="trust-heading">
    <div class="wrap">
      <p class="section-kicker">{h.trust.kicker}</p>
      <h2 id="trust-heading">
        {h.trust.heading} <span class="text-glow">{h.trust.headingBrand}</span>
      </h2>
      <p class="lede lede--tight">{h.trust.lede}</p>
      <ul class="trust-grid">
        {
          h.trust.cards.map((card) => (
            <li>
              <span class="feature-icon" aria-hidden="true">
                <Icon name={card.icon} size={22} />
              </span>
              <h3>{card.title}</h3>
              <p>{card.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-split" aria-labelledby="compare-heading">
    <div class="wrap">
      <p class="section-kicker">{h.compare.kicker}</p>
      <h2 id="compare-heading">
        {h.compare.heading} <span class="text-glow">{h.compare.headingHighlight}</span>
      </h2>
      <div class="compare-grid">
        <article class="compare-card compare-card--no">
          <p class="compare-card__label">{h.compare.manualLabel}</p>
          <ul>
            {h.compare.manual.map((item) => <li>{item}</li>)}
          </ul>
        </article>
        <article class="compare-card compare-card--yes">
          <p class="compare-card__label">{h.compare.whaleLabel}</p>
          <ul>
            {h.compare.whale.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-split" id="deliver" aria-labelledby="deliver-heading">
    <div class="wrap">
      <p class="section-kicker">{h.deliver.kicker}</p>
      <h2 id="deliver-heading">{h.deliver.heading}</h2>
      <p class="lede">{h.deliver.lede}</p>
      <ul class="trust-grid trust-grid--deliver">
        {
          h.deliver.items.map((item) => (
            <li>
              <span class="feature-icon" aria-hidden="true">
                <Icon name={item.icon} size={22} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </li>
          ))
        }
      </ul>
      <p class="deliver-stack-note">{h.deliver.stackNote}</p>
    </div>
  </section>

  <section class="section section-split" aria-labelledby="monetize-heading">
    <div class="wrap">
      <p class="section-kicker">{h.monetize.kicker}</p>
      <h2 id="monetize-heading">
        {h.monetize.heading}<span class="text-glow">{h.monetize.headingHighlight}</span>
      </h2>
      <p class="lede">{h.monetize.lede}</p>
      <ul class="trust-grid trust-grid--3">
        {
          h.monetize.cards.map((card) => (
            <li>
              <span class="feature-icon" aria-hidden="true">
                <Icon name={card.icon} size={22} />
              </span>
              <h3>{card.title}</h3>
              <p>{card.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-split section-compact" aria-labelledby="modes-heading">
    <div class="wrap">
      <p class="section-kicker">{h.modes.kicker}</p>
      <h2 id="modes-heading">{h.modes.heading}</h2>
      <ul class="stack-list">
        {
          h.modes.items.map((item) => (
            <li>
              <span class="feature-icon feature-icon--sm" aria-hidden="true">
                <Icon name={item.icon} size={18} />
              </span>
              <div>
                <h3><a href={localizePath(item.href, locale)}>{item.title}</a></h3>
                <p>{item.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section-quiet" aria-labelledby="define-heading">
    <div class="wrap">
      <h2 id="define-heading" class="section-quiet__title">{h.define.heading}</h2>
      <DefinitionBlock panel />
    </div>
  </section>

  <section class="bottom-cta" aria-labelledby="bottom-cta-heading">
    <div class="wrap bottom-cta__inner">
      <h2 id="bottom-cta-heading">
        {h.cta.title} <span class="text-glow">{h.cta.highlight}</span> {h.cta.suffix}
      </h2>
      <p class="bottom-cta__sub">{h.cta.sub}</p>
      <div class="cta-row bottom-cta__actions">
        <CtaLink label={t.common.getDemo} variant="primary" />
        <CtaLink label={t.common.consultPrice} variant="outline" href="/contact" />
      </div>
    </div>
  </section>
</BaseLayout>
