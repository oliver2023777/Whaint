---
import Icon from './Icon.astro';
import { getLocale, getMessages } from '../i18n';
import { contacts } from '../lib/site';

interface Props {
  /** compact：一行；card：三列卡片；stack：纵向商务通道（黄金微光） */
  variant?: 'compact' | 'card' | 'stack';
}

const { variant = 'card' } = Astro.props;

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);

const channels = [
  {
    icon: 'chat' as const,
    label: 'QQ',
    value: contacts.qq,
    href: `tencent://message/?uin=${contacts.qq}`,
    action: t.channels.qqAction,
    tone: 'qq',
  },
  {
    icon: 'plane' as const,
    label: 'Telegram',
    value: contacts.telegram,
    href: contacts.telegramUrl,
    action: t.channels.tgAction,
    external: true,
    tone: 'tg',
  },
  {
    icon: 'globe' as const,
    label: t.channels.demoLabel,
    value: contacts.demoHost,
    href: contacts.demoUrl,
    action: t.channels.demoAction,
    external: true,
    tone: 'demo',
  },
] as const;
---

{
  variant === 'compact' ? (
    <ul class="contact-channels contact-channels--compact">
      {channels.map((c) => (
        <li>
          <a
            class="contact-link"
            href={c.href}
            rel={'external' in c && c.external ? 'noopener noreferrer' : undefined}
            target={'external' in c && c.external ? '_blank' : undefined}
          >
            <span class="contact-ico" aria-hidden="true">
              <Icon name={c.icon} size={14} />
            </span>
            <span class="k">{c.label}</span>
            <span class="val">{c.value}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : variant === 'stack' ? (
    <ul class="contact-channels contact-channels--stack">
      {channels.map((c) => (
        <li>
          <a
            class={`contact-stack contact-stack--${c.tone}`}
            href={c.href}
            rel={'external' in c && c.external ? 'noopener noreferrer' : undefined}
            target={'external' in c && c.external ? '_blank' : undefined}
          >
            <span class="contact-stack__icon" aria-hidden="true">
              <Icon name={c.icon} size={18} />
            </span>
            <span class="contact-stack__meta">
              <span class="contact-stack__label">{c.label}</span>
              <span class="contact-stack__value">{c.value}</span>
            </span>
            <span class="contact-stack__action">
              {c.action}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <ul class="contact-channels contact-channels--card">
      {channels.map((c) => (
        <li>
          <a
            class={`contact-card contact-card--${c.tone}`}
            href={c.href}
            rel={'external' in c && c.external ? 'noopener noreferrer' : undefined}
            target={'external' in c && c.external ? '_blank' : undefined}
          >
            <span class="contact-card__icon" aria-hidden="true">
              <Icon name={c.icon} size={20} />
            </span>
            <span class="contact-card__meta">
              <span class="contact-card__label">{c.label}</span>
              <span class="contact-card__value">{c.value}</span>
            </span>
            <span class="contact-card__action">
              {c.action}
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style is:global>
  .contact-channels {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contact-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    flex: 0 0 1rem;
    color: var(--color-brand);
    line-height: 0;
  }

  .contact-ico svg {
    display: block;
    width: 14px;
    height: 14px;
  }

  .contact-channels--compact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.35rem;
    font-size: 0.88rem;
  }

  .contact-channels--compact li {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-channels--compact .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    text-decoration: none;
    color: var(--color-ink-soft);
    line-height: 1;
  }

  .contact-channels--compact .contact-link:hover {
    color: var(--color-brand);
  }

  .contact-channels--compact .k {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .contact-channels--compact .val {
    color: inherit;
  }

  .contact-channels--card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 720px) {
    .contact-channels--card {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.85rem;
    }
  }

  .contact-channels--card > li {
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .contact-card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.85rem;
    row-gap: 0.95rem;
    align-items: start;
    height: 100%;
    padding: 1.1rem 1.15rem 1.05rem;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--card-border);
    border-radius: var(--radius);
    background: var(--card-bg);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition:
      border-color 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  .contact-card::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(234, 179, 8, 0.22), transparent);
    pointer-events: none;
  }

  .contact-card:hover,
  .contact-card:focus-visible {
    border-color: var(--card-border-hover);
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-2px);
    outline: none;
  }

  .contact-card__icon {
    grid-row: 1;
    grid-column: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 0.65rem;
    border: 1px solid rgba(240, 185, 11, 0.28);
    background: rgba(240, 185, 11, 0.1);
    color: var(--color-brand);
  }

  .contact-card--tg .contact-card__icon {
    border-color: rgba(56, 189, 248, 0.32);
    background: rgba(56, 189, 248, 0.1);
    color: #7dd3fc;
  }

  .contact-card--demo .contact-card__icon {
    border-color: rgba(61, 214, 140, 0.32);
    background: rgba(61, 214, 140, 0.1);
    color: var(--color-positive);
  }

  .contact-card__meta {
    grid-row: 1;
    grid-column: 2;
    min-width: 0;
    display: grid;
    gap: 0.28rem;
  }

  .contact-card__label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 550;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contact-card__value {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 1.6vw, 1.12rem);
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-ink);
    word-break: break-all;
  }

  .contact-card--demo .contact-card__value {
    color: var(--color-brand);
  }

  .contact-card__action {
    grid-row: 2;
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: fit-content;
    margin-top: 0.1rem;
    padding: 0;
    border: 0;
    background: none;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-brand);
    transition: color 160ms var(--ease-out), gap 160ms var(--ease-out);
  }

  .contact-card:hover .contact-card__action,
  .contact-card:focus-visible .contact-card__action {
    color: #fcd535;
    gap: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card:hover,
    .contact-card:focus-visible {
      transform: none;
    }

    .contact-card:hover .contact-card__action,
    .contact-card:focus-visible .contact-card__action {
      gap: 0.35rem;
    }
  }

  .contact-channels--stack {
    display: grid;
    gap: 0.7rem;
    margin: 0;
  }

  .contact-channels--stack > li {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-stack {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.05rem;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent 48%),
      rgba(8, 10, 14, 0.72);
    text-decoration: none;
    color: inherit;
    transition:
      border-color 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out),
      transform 220ms var(--ease-out),
      background 220ms var(--ease-out);
  }

  .contact-stack::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 120% at 0% 50%, rgba(240, 185, 11, 0.14), transparent 55%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease-out);
  }

  .contact-stack:hover,
  .contact-stack:focus-visible {
    border-color: rgba(240, 185, 11, 0.42);
    box-shadow:
      0 0 0 1px rgba(240, 185, 11, 0.12),
      0 10px 28px rgba(240, 185, 11, 0.12),
      0 16px 36px rgba(0, 0, 0, 0.28);
    transform: translateY(-1px);
    outline: none;
  }

  .contact-stack:hover::before,
  .contact-stack:focus-visible::before {
    opacity: 1;
  }

  .contact-stack__icon {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.6rem;
    border: 1px solid rgba(240, 185, 11, 0.3);
    background: rgba(240, 185, 11, 0.1);
    color: var(--color-brand);
  }

  .contact-stack--tg .contact-stack__icon {
    border-color: rgba(56, 189, 248, 0.34);
    background: rgba(56, 189, 248, 0.1);
    color: #7dd3fc;
  }

  .contact-stack--demo .contact-stack__icon {
    border-color: rgba(61, 214, 140, 0.34);
    background: rgba(61, 214, 140, 0.1);
    color: var(--color-positive);
  }

  .contact-stack__meta {
    position: relative;
    z-index: 1;
    min-width: 0;
    display: grid;
    gap: 0.18rem;
  }

  .contact-stack__label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contact-stack__value {
    font-family: var(--font-mono);
    font-size: 0.98rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    word-break: break-all;
  }

  .contact-stack--demo .contact-stack__value {
    color: var(--color-brand);
  }

  .contact-stack__action {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-brand);
    transition: gap 180ms var(--ease-out), color 180ms var(--ease-out);
  }

  .contact-stack:hover .contact-stack__action,
  .contact-stack:focus-visible .contact-stack__action {
    gap: 0.42rem;
    color: #fcd535;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-stack:hover,
    .contact-stack:focus-visible {
      transform: none;
    }

    .contact-stack:hover .contact-stack__action,
    .contact-stack:focus-visible .contact-stack__action {
      gap: 0.28rem;
    }
  }
</style>
