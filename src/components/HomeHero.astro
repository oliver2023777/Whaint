---
import CtaLink from './CtaLink.astro';
import { getLocale, getMessages } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const c = t.hero.console;

function renderHeadline(text: string, highlights: readonly string[]) {
  const parts: Array<{ text: string; glow: boolean }> = [];
  let rest = text;
  while (rest.length) {
    let hit: { word: string; idx: number } | null = null;
    for (const word of highlights) {
      const idx = rest.indexOf(word);
      if (idx >= 0 && (hit === null || idx < hit.idx)) {
        hit = { word, idx };
      }
    }
    if (!hit) {
      parts.push({ text: rest, glow: false });
      break;
    }
    if (hit.idx > 0) {
      parts.push({ text: rest.slice(0, hit.idx), glow: false });
    }
    parts.push({ text: hit.word, glow: true });
    rest = rest.slice(hit.idx + hit.word.length);
  }
  return parts;
}

function renderTagline(text: string, highlight: string) {
  const idx = text.indexOf(highlight);
  if (idx < 0) return [{ text, glow: false }];
  const parts: Array<{ text: string; glow: boolean }> = [];
  if (idx > 0) parts.push({ text: text.slice(0, idx), glow: false });
  parts.push({ text: highlight, glow: true });
  const rest = text.slice(idx + highlight.length);
  if (rest) parts.push({ text: rest, glow: false });
  return parts;
}

const headlineParts = renderHeadline(t.hero.headline, t.hero.headlineHighlights);
const taglineParts = renderTagline(c.tagline, c.taglineHighlight);
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__glow" aria-hidden="true"></div>
  <div class="wrap home-hero__inner">
    <p class="home-hero__badge motion-rise">
      <span class="home-hero__badge-lamp" aria-hidden="true"></span>
      {t.hero.badge}
    </p>
    <h1 id="home-title" class="home-hero__title motion-rise-delay">
      {
        headlineParts.map((part) =>
          part.glow ? (
            <span class="text-glow">{part.text}</span>
          ) : (
            part.text
          )
        )
      }
    </h1>
    <p class="home-hero__support motion-fade">{t.hero.support}</p>
    <div class="cta-row motion-fade">
      <CtaLink label={t.common.getDemo} variant="primary" />
      <CtaLink label={t.common.consultPrice} variant="ghost" href="/contact" />
    </div>

    <div class="hero-terminal motion-fade" aria-label={c.tagline}>
      <div class="hero-terminal__chrome" aria-hidden="true">
        <span class="dot dot--r"></span>
        <span class="dot dot--y"></span>
        <span class="dot dot--g"></span>
        <span class="hero-terminal__title">{c.chromeTitle}</span>
        <span class="hero-terminal__live">
          <i></i>
          {c.liveBadge}
        </span>
      </div>
      <div class="hero-terminal__body">
        <p class="hero-terminal__tagline">
          {
            taglineParts.map((part) =>
              part.glow ? (
                <span class="text-glow">{part.text}</span>
              ) : (
                part.text
              )
            )
          }
        </p>
        <pre class="hero-terminal__code"><code><span class="hero-terminal__prompt">{c.prompt}</span> <span class="hero-terminal__cmd">{c.command}</span><span class="hero-terminal__cursor" aria-hidden="true"></span>
<span class="hero-terminal__out">{c.output}</span></code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: clamp(2.75rem, 7vw, 5.5rem) 0 clamp(2.25rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-line);
    background:
      radial-gradient(55% 42% at 50% 0%, rgba(234, 179, 8, 0.1), transparent 70%),
      radial-gradient(40% 35% at 88% 18%, rgba(240, 185, 11, 0.05), transparent 72%),
      radial-gradient(38% 32% at 8% 78%, rgba(61, 214, 140, 0.05), transparent 70%),
      var(--color-bg);
  }

  .home-hero__glow {
    position: absolute;
    inset: -6% 20% auto 20%;
    height: 42%;
    background: radial-gradient(ellipse 55% 55% at 50% 0%, rgba(234, 179, 8, 0.08), transparent 72%);
    pointer-events: none;
    z-index: 0;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 56rem;
  }

  .home-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.1rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
  }

  .home-hero__badge-lamp {
    position: relative;
    flex: 0 0 auto;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--color-brand);
    box-shadow:
      0 0 0 0 rgba(240, 185, 11, 0.55),
      0 0 10px rgba(240, 185, 11, 0.75);
    animation: badge-lamp 1.8s ease-in-out infinite;
  }

  .home-hero__badge-lamp::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid rgba(240, 185, 11, 0.35);
    opacity: 0.7;
  }

  .home-hero__title {
    margin: 0;
    font-size: clamp(1.7rem, 6.2vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
    color: var(--color-ink);
  }

  .home-hero__support {
    margin: 1rem 0 0;
    max-width: 42rem;
    font-size: clamp(0.95rem, 1.8vw, 1.08rem);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .hero-terminal {
    margin-top: 1.75rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.95rem;
    background: #080a0e;
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.45),
      0 0 28px rgba(234, 179, 8, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .hero-terminal__chrome {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.28);
  }

  .dot {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .dot--r {
    background: #ff5f57;
  }
  .dot--y {
    background: #febc2e;
  }
  .dot--g {
    background: #28c840;
  }

  .hero-terminal__title {
    margin-left: 0.45rem;
    min-width: 0;
    flex: 1 1 auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hero-terminal__live {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--color-positive);
  }

  .hero-terminal__live i {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: var(--color-positive);
    box-shadow: 0 0 8px rgba(61, 214, 140, 0.7);
    animation: pulse-live 1.6s ease-in-out infinite;
  }

  .hero-terminal__body {
    padding: clamp(1.15rem, 3vw, 1.6rem) clamp(1rem, 3vw, 1.45rem) clamp(1.25rem, 3vw, 1.7rem);
  }

  .hero-terminal__tagline {
    margin: 0 0 1rem;
    font-size: clamp(0.98rem, 2vw, 1.12rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.45;
    color: var(--color-ink);
  }

  .hero-terminal__code {
    margin: 0;
    padding: 0.95rem 1rem;
    overflow-x: auto;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0.65rem;
    background: #05070a;
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 1.8vw, 0.92rem);
    line-height: 1.7;
    color: var(--color-ink-soft);
  }

  .hero-terminal__prompt {
    color: var(--color-muted);
  }

  .hero-terminal__prompt::before {
    content: '$ ';
    color: var(--color-brand);
  }

  .hero-terminal__cmd {
    color: var(--color-brand);
    font-weight: 650;
  }

  .hero-terminal__cursor {
    display: inline-block;
    width: 0.45rem;
    height: 1em;
    margin-left: 0.15rem;
    vertical-align: text-bottom;
    background: var(--color-brand);
    animation: blink-cursor 1.1s steps(1) infinite;
  }

  .hero-terminal__out {
    color: #f0c84a;
  }

  @keyframes pulse-live {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  @keyframes badge-lamp {
    0%,
    100% {
      opacity: 1;
      box-shadow:
        0 0 0 0 rgba(240, 185, 11, 0.45),
        0 0 10px rgba(240, 185, 11, 0.7);
    }
    50% {
      opacity: 0.72;
      box-shadow:
        0 0 0 5px rgba(240, 185, 11, 0),
        0 0 14px rgba(240, 185, 11, 0.95);
    }
  }

  @keyframes blink-cursor {
    0%,
    45% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (max-width: 479px) {
    .home-hero :global(.cta-row) {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.55rem;
    }

    .home-hero :global(.cta-row .btn) {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero__badge-lamp,
    .hero-terminal__live i,
    .hero-terminal__cursor {
      animation: none;
    }
  }
</style>
