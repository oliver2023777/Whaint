# 营销站公网地址（canonical / OG / sitemap）— 改后需 ./start.sh 重建
PUBLIC_SITE_URL=https://whaint.cn

# 产品站 / 演示站入口
PUBLIC_APP_URL=https://whacore.cn

# 商务联系邮箱
PUBLIC_CONTACT_EMAIL=hello@whalecore.example

# ── 产品进化：构建时从私有仓 Whapub 同步 marketing/changelog ──
SYNC_CHANGELOG=1
WHAPUB_REPO=https://github.com/oliver2023777/Whapub.git
WHAPUB_REF=main
# GitHub PAT：读 Whapub（Contents: Read）；若还要 push 回 Whaint，同一 PAT 需对 Whaint 有 Contents: Write
WHAPUB_TOKEN=
# 同步后写入本仓并推送（默认开；公开仓 GEO）。仅本地构建可设 PUSH=0
SYNC_CHANGELOG_COMMIT=1
SYNC_CHANGELOG_PUSH=1
# 可选：专用于 push Whaint 的 PAT（不填则用 WHAINT_TOKEN ← GITHUB_TOKEN ← WHAPUB_TOKEN）
# WHAINT_TOKEN=

TZ=Asia/Shanghai
