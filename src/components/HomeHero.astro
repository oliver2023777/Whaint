---
import CtaLink from './CtaLink.astro';
import { getLocale, getMessages } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);

function renderHeadline(text: string, highlights: readonly string[]) {
  const parts: Array<{ text: string; glow: boolean }> = [];
  let rest = text;
  while (rest.length) {
    let hit: { word: string; idx: number } | null = null;
    for (const word of highlights) {
      const idx = rest.indexOf(word);
      if (idx >= 0 && (hit === null || idx < hit.idx)) {
        hit = { word, idx };
      }
    }
    if (!hit) {
      parts.push({ text: rest, glow: false });
      break;
    }
    if (hit.idx > 0) {
      parts.push({ text: rest.slice(0, hit.idx), glow: false });
    }
    parts.push({ text: hit.word, glow: true });
    rest = rest.slice(hit.idx + hit.word.length);
  }
  return parts;
}

const headlineParts = renderHeadline(t.hero.headline, t.hero.headlineHighlights);
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__glow" aria-hidden="true"></div>
  <div class="wrap home-hero__inner">
    <p class="home-hero__badge motion-rise">
      {t.hero.badge}
    </p>
    <h1 id="home-title" class="home-hero__title motion-rise-delay">
      {
        headlineParts.map((part) =>
          part.glow ? (
            <span class="text-glow">{part.text}</span>
          ) : (
            part.text
          )
        )
      }
    </h1>
    <p class="home-hero__support motion-fade">{t.hero.support}</p>
    <div class="cta-row motion-fade">
      <CtaLink label={t.common.getDemo} variant="primary" />
      <CtaLink label={t.common.consultPrice} variant="ghost" href="/contact" />
    </div>

    <div class="hero-console motion-fade" aria-hidden="true">
      <div class="hero-console__chrome">
        <span class="dot dot--r"></span>
        <span class="dot dot--y"></span>
        <span class="dot dot--g"></span>
        <span class="hero-console__title">{t.hero.console.chromeTitle}</span>
        <span class="hero-console__live">
          <i></i>
          {t.hero.console.liveBadge}
        </span>
      </div>
      <div class="hero-console__body hero-console__body--slim">
        <p class="hero-console__tagline">
          {t.hero.console.tagline.split(t.hero.console.taglineHighlight).map((chunk, i, arr) => (
            <>
              {chunk}
              {i < arr.length - 1 && <span class="text-glow">{t.hero.console.taglineHighlight}</span>}
            </>
          ))}
        </p>
        <div class="hero-term">
          <div class="hero-term__line">
            <span class="prompt">$</span>
            <span class="cmd">./pack/start.sh</span>
          </div>
          <div class="hero-term__out hero-term__out--ok">{t.hero.console.output}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding: clamp(5rem, 12vw, 7rem) 0 clamp(4.5rem, 10vw, 7rem);
    border-bottom: 1px solid var(--color-line);
    background:
      radial-gradient(120% 90% at 50% -5%, rgba(234, 179, 8, 0.22), transparent 58%),
      radial-gradient(80% 70% at 85% 20%, rgba(240, 185, 11, 0.12), transparent 50%),
      radial-gradient(70% 60% at 5% 80%, rgba(61, 214, 140, 0.07), transparent 48%),
      var(--color-bg);
  }

  .home-hero__glow {
    position: absolute;
    inset: -10% -15% auto -15%;
    height: 75%;
    background:
      radial-gradient(ellipse 80% 70% at 50% 0%, rgba(234, 179, 8, 0.18), transparent 65%),
      radial-gradient(closest-side, rgba(240, 185, 11, 0.1), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 56rem;
  }

  .home-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.35rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
  }

  .home-hero__title {
    margin: 0;
    font-size: clamp(2rem, 5.2vw, 3.15rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
    color: var(--color-ink);
  }

  .home-hero__support {
    margin: 1.35rem 0 0;
    max-width: 42rem;
    font-size: clamp(1.02rem, 2vw, 1.12rem);
    line-height: 1.7;
    color: var(--color-ink-soft);
  }

  .hero-console {
    position: relative;
    margin-top: 3rem;
    width: 100%;
    max-width: 56rem;
    border: 1px solid rgba(234, 179, 8, 0.2);
    border-radius: 1rem;
    background:
      linear-gradient(155deg, rgba(255, 255, 255, 0.07) 0%, transparent 42%),
      linear-gradient(180deg, rgba(8, 10, 14, 0.82), rgba(4, 5, 8, 0.92)),
      rgba(6, 8, 12, 0.72);
    box-shadow:
      0 0 0 1px rgba(234, 179, 8, 0.12),
      0 28px 64px rgba(0, 0, 0, 0.55),
      0 0 50px rgba(234, 179, 8, 0.15),
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -1px 0 rgba(234, 179, 8, 0.06);
    backdrop-filter: blur(22px) saturate(1.25);
    -webkit-backdrop-filter: blur(22px) saturate(1.25);
    overflow: hidden;
  }

  .hero-console::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(80% 60% at 100% 0%, rgba(234, 179, 8, 0.1), transparent 55%),
      radial-gradient(60% 50% at 0% 100%, rgba(255, 255, 255, 0.04), transparent 50%);
    z-index: 0;
  }

  .hero-console__chrome,
  .hero-console__body {
    position: relative;
    z-index: 1;
  }

  .hero-console__chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.95rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(0, 0, 0, 0.28);
  }

  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }

  .dot--r {
    background: #ff5f57;
  }
  .dot--y {
    background: #febc2e;
  }
  .dot--g {
    background: #28c840;
  }

  .hero-console__title {
    margin-left: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .hero-console__live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--color-positive);
  }

  .hero-console__live i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-positive);
    box-shadow: 0 0 8px rgba(61, 214, 140, 0.7);
    animation: pulse-live 1.6s ease-in-out infinite;
  }

  .hero-console__body {
    padding: 1.1rem 1.1rem 1.2rem;
    display: grid;
    gap: 1rem;
  }

  .hero-console__body--slim {
    gap: 0.85rem;
  }

  .hero-console__tagline {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .hero-console__meta,
  .hero-console__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .hero-console__meta .k,
  .hero-console__stats .k {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .hero-console__meta .v,
  .hero-console__stats .v {
    display: block;
    font-size: 0.82rem;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .v--ok {
    color: var(--color-positive) !important;
  }

  .hero-term {
    padding: 0.9rem 1rem;
    border-radius: 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background:
      linear-gradient(180deg, rgba(240, 185, 11, 0.06), transparent 70%),
      rgba(0, 0, 0, 0.35);
    font-family: var(--font-mono);
    display: grid;
    gap: 0.45rem;
  }

  .hero-term__line {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.92rem;
  }

  .hero-term .prompt {
    color: var(--color-brand);
    font-weight: 700;
  }

  .hero-term .cmd {
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }

  .hero-term__out {
    font-size: 0.78rem;
    color: var(--color-muted);
    line-height: 1.45;
    padding-left: 1.05rem;
  }

  .hero-term__out--ok {
    color: var(--color-positive);
  }

  @media (max-width: 560px) {
    .hero-console__meta,
    .hero-console__stats {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-console__live i {
      animation: none !important;
    }
  }
</style>
