---
import { site } from '../lib/site';

/**
 * 品牌标：对齐产品站 HeaderBar / BrandMark
 * 鲸擎（金）· Whale（白）Core（金）
 */
interface Props {
  href?: string;
  size?: 'sm' | 'md';
}

const { href, size = 'md' } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  class:list={['brand-mark', `brand-mark--${size}`]}
  href={href}
  aria-label={site.displayName}
>
  <img
    class="brand-mark__logo"
    src="/icons/whalecore.svg"
    alt=""
    width="32"
    height="32"
    draggable="false"
  />
  <span class="brand-mark__name">
    <span class="brand-mark__zh">鲸擎</span>
    <span class="brand-mark__dot" aria-hidden="true">·</span>
    <span class="brand-mark__en">
      <span class="brand-mark__whale">Whale</span><span class="brand-mark__core">Core</span>
    </span>
  </span>
</Tag>

<style>
  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    line-height: 1;
  }

  .brand-mark__logo {
    display: block;
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }

  .brand-mark--sm .brand-mark__logo {
    width: 1.75rem;
    height: 1.75rem;
  }

  .brand-mark__name {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
  }

  .brand-mark--sm .brand-mark__name {
    font-size: 1.05rem;
  }

  .brand-mark__zh {
    color: #d4af37;
  }

  .brand-mark__dot {
    margin: 0 0.35rem;
    color: rgba(255, 255, 255, 0.25);
  }

  .brand-mark__whale {
    color: #eaecef;
  }

  .brand-mark__core {
    color: #d4af37;
  }
</style>
