---
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocale, getMessages, localizePath } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const c = t.contact;
---

<BaseLayout title={c.title} description={c.description} path="/contact">
  <PageHero kicker={c.kicker} title={c.pageTitle} lede={c.lede} />

  <section class="section section-split section-compact" id="boundary">
    <div class="wrap">
      <p class="section-kicker">{c.boundary.kicker}</p>
      <h2>{c.boundary.heading}</h2>
      {c.boundary.lede && <p class="section-lede">{c.boundary.lede}</p>}
      <div class="info-grid info-grid--3" style="margin-top: 1.5rem">
        {
          c.boundary.cards.map((card) => (
            <article class:list={['info-card', card.variant === 'no' && 'info-card--no']}>
              <span class="feature-icon" aria-hidden="true">
                <Icon name={card.icon} size={20} />
              </span>
              <h3 class="info-card__title">{card.title}</h3>
              <ul class:list={['info-list', card.variant === 'no' && 'info-list--cross']}>
                {card.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="boundary-next">
        <a href={localizePath('/#biz', locale)}>{c.boundary.next}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  #boundary {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .section-lede {
    margin: 0.45rem 0 0;
    max-width: 40rem;
    color: #a1a1aa;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .boundary-next {
    margin: 1.75rem 0 0;
  }

  .boundary-next a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-brand);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .boundary-next a::after {
    content: '→';
    transition: transform 160ms var(--ease-out);
  }

  .boundary-next a:hover::after {
    transform: translateX(3px);
  }
</style>
