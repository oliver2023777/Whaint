---
import Icon from '../components/Icon.astro';
import PageCtaBand from '../components/PageCtaBand.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocale, getMessages } from '../i18n';

const locale = getLocale(Astro.currentLocale);
const t = getMessages(locale);
const s = t.solutions;
---

<BaseLayout title={s.title} description={s.description} path="/solutions">
  <PageHero kicker={s.kicker} title={s.pageTitle} lede={s.lede} />

  <nav class="pill-sticky" data-solutions-sticky aria-label={s.tabsAria}>
    <div class="wrap pill-nav">
      {
        s.modes.map((mode, i) => (
          <a
            class:list={['pill-nav__item', i === 0 && 'is-active']}
            href={`#${mode.id}`}
            data-solutions-nav={mode.id}
          >
            <Icon name={mode.icon} size={14} />
            {mode.label}
          </a>
        ))
      }
    </div>
  </nav>

  <section class="section section-split">
    <div class="wrap solutions-stack">
      {
        s.modes.map((mode) => (
          <div id={mode.id} class="mode-panel" data-solutions-section={mode.id}>
            <div class="mode-panel__intro">
              <h2>{mode.title}</h2>
              <p>{mode.lede}</p>
            </div>
            <div class="info-grid info-grid--3">
              {mode.cards.map((card) => (
                <article class="info-card">
                  <span class="feature-icon" aria-hidden="true">
                    <Icon name={card.icon} size={20} />
                  </span>
                  <h3 class="info-card__title">{card.title}</h3>
                  <p class="info-card__lede">{card.lede}</p>
                  <ul class="info-list">
                    {card.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <PageCtaBand />
</BaseLayout>

<style>
  .solutions-stack {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .mode-panel {
    scroll-margin-top: calc(var(--header-h) + 3.75rem);
  }

  .mode-panel__intro {
    margin: 0 0 1.35rem;
    max-width: 40rem;
  }

  .mode-panel__intro h2 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
  }

  .mode-panel__intro p {
    margin: 0;
    color: #a1a1aa;
    font-size: 0.9375rem;
    line-height: 1.65;
  }
</style>

<script>
  const sticky = document.querySelector('[data-solutions-sticky]');
  if (sticky) {
    const links = Array.from(sticky.querySelectorAll('[data-solutions-nav]'));
    const sections = Array.from(document.querySelectorAll('[data-solutions-section]'));

    const setActive = (id) => {
      links.forEach((link) => {
        link.classList.toggle('is-active', link.getAttribute('data-solutions-nav') === id);
      });
    };

    if (sections[0]) setActive(sections[0].getAttribute('data-solutions-section') || '');

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        const top = visible[0]?.target;
        if (top instanceof HTMLElement) {
          setActive(top.getAttribute('data-solutions-section') || '');
        }
      },
      {
        rootMargin: '-30% 0px -55% 0px',
        threshold: [0.1, 0.25, 0.5],
      }
    );

    sections.forEach((section) => observer.observe(section));

    links.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.getAttribute('data-solutions-nav');
        if (id) setActive(id);
      });
    });

    const fromHash = () => {
      const id = window.location.hash.replace(/^#/, '');
      if (id) setActive(id);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
</script>
